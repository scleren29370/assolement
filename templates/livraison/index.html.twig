{% extends 'base.html.twig' %}

{% block title %}Livraisons{% endblock %}

{% block body %}
<div class="container mt-4">

    <h1 class="mb-4">📦 Livraisons</h1>

    <a href="{{ path('livraison_new') }}" class="btn btn-primary mb-3">➕ Ajouter une livraison</a>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Date</th>
                <th>Culture</th>
                <th>Campagne</th>
                <th>Quantité (t)</th>
                <th>Acheteur</th>
            </tr>
        </thead>
        <tbody>
        {% for l in livraisons %}
            <tr>
                <td>{{ l.dateLivraison|date('d/m/Y') }}</td>
                <td>{{ l.culture.nom }}</td>
                <td>{{ l.campagne.annee }}</td>
                <td>{{ l.quantiteTotale|number_format(2, ',', ' ') }}</td>
                <td>{{ l.acheteur ?? '-' }}</td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="text-center text-muted">Aucune livraison.</td></tr>
        {% endfor %}
        </tbody>
    </table>

</div>
{% endblock %}
