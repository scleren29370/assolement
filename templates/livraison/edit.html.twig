{% extends 'base.html.twig' %}

{% block title %}Modifier la livraison{% endblock %}

{% block body %}
<div class="container mt-4">

    <h1 class="mb-4">✏️ Modifier la livraison</h1>

    {{ form_start(form) }}

    <div class="card p-4 shadow-sm">

        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.culture) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.campagne) }}
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                {{ form_row(form.quantiteTotale) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.dateLivraison) }}
            </div>
        </div>

        <div class="mt-3">
            {{ form_row(form.acheteur) }}
        </div>

        <hr class="my-4">

        <h4>🧩 Parcelles concernées</h4>
        <p class="text-muted">Attention : modifier les parcelles ne recalculera pas automatiquement les rendements.</p>

        <div class="mt-2">
            {{ form_row(form.assolements) }}
        </div>

        <button class="btn btn-success mt-4">💾 Enregistrer les modifications</button>

    </div>

    {{ form_end(form) }}

</div>
{% endblock %}
