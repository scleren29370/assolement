{% extends 'base.html.twig' %}

{% block title %}Nouvelle livraison{% endblock %}

{% block body %}
<div class="container mt-4">

    <h1 class="mb-4">➕ Nouvelle livraison</h1>

    {{ form_start(form) }}

    <div class="card p-4 shadow-sm">

        <div class="row">
            <div class="col-md-6">{{ form_row(form.culture) }}</div>
            <div class="col-md-6">{{ form_row(form.campagne) }}</div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">{{ form_row(form.quantiteTotale) }}</div>
            <div class="col-md-6">{{ form_row(form.dateLivraison) }}</div>
        </div>

        <div class="mt-3">{{ form_row(form.acheteur) }}</div>

        <hr class="my-4">

        <h4>🧩 Parcelles concernées</h4>

        <div id="assolements-container">
            {% include 'livraison/_assolements.html.twig' with {
                assolements: form.assolements.vars.choices|map(c => c.data)
            } %}
        </div>

        <button class="btn btn-success mt-4">💾 Enregistrer</button>

    </div>

    {{ form_end(form) }}

</div>
{% endblock %}

{% block javascripts %}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
$(document).ready(function () {

    $('#livraison_culture').on('change', function () {

        let cultureId = $(this).val();

        if (!cultureId) {
            $('#assolements-container').html('<p>Choisissez une culture.</p>');
            return;
        }

        $.ajax({
            url: '{{ path("livraison_assolements") }}',
            method: 'GET',
            data: { culture: cultureId },
            success: function (html) {
                $('#assolements-container').html(html);
            }
        });
    });

});
</script>
{% endblock %}
