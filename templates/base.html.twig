<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Assolement{% endblock %}</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>

    <body>

<div class="container mt-2">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3 rounded">
        <a class="navbar-brand" href="{{ path('app_accueil') }}">Assolement</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menuPrincipal">
            <ul class="navbar-nav ms-auto">

                {# MENU GESTION #}
                <li class="nav-item dropdown me-3">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        Gestion
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li><h6 class="dropdown-header">Parcelles</h6></li>
                        <li><a class="dropdown-item" href="{{ path('parcelle_index') }}">Liste des parcelles</a></li>
                        <li><a class="dropdown-item" href="{{ path('parcelle_new') }}">Ajouter une parcelle</a></li>

                        <li><hr class="dropdown-divider"></li>

                        <li><h6 class="dropdown-header">Cultures</h6></li>
                        <li><a class="dropdown-item" href="{{ path('culture_index') }}">Liste des cultures</a></li>
                        <li><a class="dropdown-item" href="{{ path('culture_new') }}">Ajouter une culture</a></li>

                      <li><hr class="dropdown-divider"></li>

            {# CAMPAGNES #}
            <li><h6 class="dropdown-header">Campagnes</h6></li>
            <li><a class="dropdown-item" href="{{ path('campagne_index') }}">Liste des campagnes</a></li>
            <li><a class="dropdown-item" href="{{ path('campagne_new') }}">Ajouter une campagne</a></li>
                    </ul>
                </li>

                {# MENU ASSOLEMENT #}
   <li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
        Assolement
    </a>

    <ul class="dropdown-menu dropdown-menu-end">

        <li><a class="dropdown-item" href="{{ path('assolement_index') }}">Liste des assolements</a></li>
        <li><a class="dropdown-item" href="{{ path('assolement_new') }}">Ajouter un assolement</a></li>

        <li><hr class="dropdown-divider"></li>

        <li><h6 class="dropdown-header">Campagnes</h6></li>

        {% for campagne in campagnes_dynamiques %}
            <li>
                <a class="dropdown-item"
                   href="{{ path('assolement_par_campagne', { id: campagne.id }) }}">
                    {{ campagne.annee }}
                </a>
            </li>
        {% else %}
            <li><span class="dropdown-item text-muted">Aucune campagne</span></li>
        {% endfor %}
    </ul>
</li>
            </ul>
        </div>
    </nav>
</div>

        <div class="container mt-4">
            {% block body %}{% endblock %}
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
