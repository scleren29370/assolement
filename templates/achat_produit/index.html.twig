{% extends 'base.html.twig' %}

{% block title %}Achats de produits{% endblock %}

{% block body %}

<h1 class="mb-4">🛒 Achats de produits</h1>

<a href="{{ path('achat_produit_new') }}" class="btn btn-primary mb-3">
    ➕ Ajouter un achat
</a>

{% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
{% endfor %}

<div class="card shadow-sm">
    <div class="card-header bg-info text-white">
        Liste des achats
    </div>

    <div class="card-body p-0">
        <table class="table table-striped table-bordered mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Produit</th>
                    <th>Type</th>
                    <th>Unité</th>
                    <th>Prix unitaire</th>
                    <th>Quantité</th>
                    <th>Date d’achat</th>
                    <th>Campagne</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for achat in achats %}
                    <tr>
                        <td>{{ achat.produit.nom }}</td>
                        <td>{{ achat.produit.type }}</td>
                        <td>{{ achat.produit.unite }}</td>
                        <td>{{ achat.prixUnitaire }} €</td>
                        <td>{{ achat.quantite }}</td>
                        <td>{{ achat.dateAchat|date('d/m/Y') }}</td>
                        <td>{{ achat.campagne.annee }}</td>

                        <td>
                            <a href="{{ path('achat_produit_edit', {id: achat.id}) }}"
                               class="btn btn-sm btn-warning">
                                ✏ Modifier
                            </a>

                            <a href="{{ path('achat_produit_delete', {id: achat.id}) }}"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Supprimer cet achat ?');">
                                🗑 Supprimer
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center text-muted py-3">
                            Aucun achat enregistré.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
